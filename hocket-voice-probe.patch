diff --git a/sdk/platform/opxy-1.2.1/hocket_probe.cpp b/sdk/platform/opxy-1.2.1/hocket_probe.cpp
new file mode 100644
index 0000000..5dda2bc
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/hocket_probe.cpp
@@ -0,0 +1,218 @@
+#include "hocket_probe.hpp"
+#include "hocket_probe_voice.hpp"
+#include "player_activity.hpp"
+#include "players.hpp"
+#include "stock.hpp"
+
+using namespace opxy;
+using platform::stock;
+using hprobe::Tag;
+extern "C" u32 sdk_voice_ticks() __asm__("sdk_voice_ticks");
+namespace {
+struct Mark { u32 owner,start; u16 serial; u8 source,fade; };
+Mark marks[8][128];
+void* stepping;
+Tag sending, receiving;
+hprobe::Watches watches;
+u32 sent[8];                         // GUI role
+u32 received[8], rendered[8], lastOwner[8]; // audio role
+bool sawNote[8];
+struct Snapshot {
+    u32 track, token, requestedAt, acknowledgedAt, acknowledgedToken;
+    u32 owner, counts;
+    bool valid;
+};
+Snapshot gui;
+const u32 pollInterval = 764; // Same clock as the player's quarter-second stall detector.
+const u32 reportType = 0xb5, requestSize = 9, replySize = 16;
+typedef u32 Enqueue(void*,u32,const u8*,u32,u32,u32,u32);
+typedef u32 Note(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32);
+
+platform::PlayerChord* records(void* object) {
+    return reinterpret_cast<platform::PlayerChord*>(static_cast<u8*>(object)+0x10c);
+}
+Tag tone_tag(u32 dest,u32 pitch,const u8* tone) {
+    if (!stepping || dest>=8 || pitch>=128 || static_cast<u32*>(stepping)[1]!=dest) return {};
+    const platform::Address lo=reinterpret_cast<platform::Address>(records(stepping));
+    const platform::Address addr=reinterpret_cast<platform::Address>(tone);
+    if (addr<lo+4 || addr>=lo+8*sizeof(platform::PlayerChord)) return {};
+    const u32 offset=static_cast<u32>(addr-lo)%sizeof(platform::PlayerChord);
+    if (offset>=64 || (offset&7)!=4 || tone[0]!=pitch) return {};
+    const Mark& m=marks[dest][pitch];
+    const u16 serial=tone[2]|(u16(tone[3])<<8);
+    if (!serial || serial!=m.serial) return {};
+    return {m.owner,m.source,static_cast<u8>(dest),m.fade,m.start};
+}
+Tag for_track(u32 track) { return receiving.dest==track ? receiving : Tag{}; }
+u32 read32(const u8* p) {
+    return u32(p[0]) | (u32(p[1])<<8) | (u32(p[2])<<16) | (u32(p[3])<<24);
+}
+void write32(u8* p,u32 v) {
+    for (u32 i=0;i<4;++i) p[i]=static_cast<u8>(v>>(8*i));
+}
+void send_report(const u8* p,u32 size) {
+    // Stock's 0xb5 status sender at 8d4d699c uses this queue and addressing.
+    stock<Enqueue>(0x11a00ec0)(platform::at<void>(0x841460b4),reportType,p,size,0,255,255);
+}
+bool report(const u8* m) {
+    const u8* p=m+4;
+    if (m[2]!=reportType) return false;
+    if (m[3]==13 && p[0]=='H' && p[1]=='K' && p[2]==1 && p[3]<8 && p[4]=='F'
+        && p[9]<8 && p[10]>=1 && p[10]<=6 && read32(p+5)) {
+        if (!stock<u32()>(0x8d5c3eac)()) {
+            const u32 age=p[11]|(u32(p[12])<<8);
+            watches.release({read32(p+5),p[3],p[9],p[10],sdk_voice_ticks()-age});
+        }
+        return true;
+    }
+    if (m[3]!=requestSize && m[3]!=replySize) return false;
+    // Stock 1.2.1 handles subcommands 0..3. Hocket owns only this versioned request/reply format.
+    if (p[0]!=0x48 || p[1]!='K' || p[2]!=1 || p[3]>=8 || p[4]!='S') return false;
+    const u32 t=p[3], token=read32(p+5);
+    if (!token) return false;
+    const bool onGui=stock<u32()>(0x8d5c3eac)()!=0;
+    if (m[3]==requestSize && !onGui) {
+        alignas(4) u8 reply[replySize];
+        __builtin_memcpy(reply,p,requestSize);
+        reply[9]=received[t]%100; reply[10]=rendered[t]%100;
+        reply[11]=sawNote[t];
+        write32(reply+12,lastOwner[t]);
+        send_report(reply,sizeof reply);
+    } else if (m[3]==replySize && onGui && gui.track==t && token==gui.token
+               && p[9]<100 && p[10]<100 && p[11]<=1 && (read32(p+12)>>16)<=8) {
+        gui.counts=(u32(p[9])<<8)|(u32(p[10])<<16)|(u32(p[11])<<24);
+        gui.owner=read32(p+12);
+        gui.acknowledgedAt=gui.requestedAt;
+        gui.acknowledgedToken=token;
+        gui.valid=true;
+    }
+    return true;
+}
+}
+
+extern "C" {
+u32 sdk_hprobe_emit(u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,u32,const u8*) __asm__("sdk_hprobe_emit");
+u32 sdk_hprobe_queue(void*,u32,const u8*,u32,u32,u32,u32) __asm__("sdk_hprobe_queue");
+u32 sdk_hprobe_dispatch(void*,const u8*) __asm__("sdk_hprobe_dispatch");
+void* sdk_hprobe_fresh(u8*,const u8*,u32) __asm__("sdk_hprobe_fresh");
+void sdk_hprobe_pending(void*,u32) __asm__("sdk_hprobe_pending");
+void* sdk_hprobe_promote(u8*,const u8*,u32) __asm__("sdk_hprobe_promote");
+u32 sdk_hprobe_render(void*,i32*) __asm__("sdk_hprobe_render");
+
+void sdk_hprobe_release(u32 source,u32 dest,u32 owner,u32 fade,u32 start) {
+    if (source>=8 || dest>=8 || !owner || !fade || fade>6) return;
+    // Stock can still be holding an unconsumed note when the gate closes.
+    for (Mark& m:marks[dest]) {
+        if (m.owner==owner && m.source==source) { m.fade=static_cast<u8>(fade); m.start=start; }
+    }
+    const u32 age=hprobe::wire_age(sdk_voice_ticks(),start);
+    alignas(4) u8 p[13]={'H','K',1,static_cast<u8>(source),'F'};
+    write32(p+5,owner);
+    p[9]=static_cast<u8>(dest); p[10]=static_cast<u8>(fade);
+    p[11]=static_cast<u8>(age); p[12]=static_cast<u8>(age>>8);
+    send_report(p,sizeof p);
+}
+void sdk_hprobe_stamp(void* object,u32 dest,u32 pitch,u32 source,u32 owner,u32 fade,u32 start) {
+    if (!owner || dest>=8 || source>=8 || pitch>=128) return;
+    auto* r=records(object);
+    const u32 held=*reinterpret_cast<const u32*>(static_cast<u8*>(object)+0x34c);
+    if (held>8) return;
+    for (u32 i=0;i<held;++i) {
+        if (r[i].root!=pitch || r[i].count!=1) continue;
+        auto& t=r[i].tones[0];
+        if (t.pitch!=pitch || t.delay!=0) continue;
+        Mark& m=marks[dest][pitch];
+        if (!++m.serial) ++m.serial;
+        m.start=start; m.fade=fade<=6 ? static_cast<u8>(fade) : 0;
+        m.owner=owner; m.source=static_cast<u8>(source);
+        t.unused[0]=static_cast<u8>(m.serial);
+        t.unused[1]=static_cast<u8>(m.serial>>8);
+        return;
+    }
+}
+void sdk_hprobe_step(void* object) {
+    void* previous=stepping;
+    stepping=object;
+    stock<void(void*)>(platform::kMaestroStep)(object);
+    stepping=previous;
+}
+u32 sdk_hprobe_emit(u32 ctx,u32 track,u32 pitch,u32 a,u32 b,u32 vel,u32 d,
+                    u32 e,u32 f,u32 g,u32 h,u32 j,const u8* tone) {
+    const Tag previous=sending;
+    sending=tone_tag(track,pitch,tone);
+    const u32 result=stock<Note>(0x8d595738)(ctx,track,pitch,a,b,vel,d,e,f,g,h,j);
+    sending=previous;
+    return result;
+}
+u32 sdk_hprobe_queue(void* queue,u32 type,const u8* p,u32 n,u32 flags,u32 src,u32 dst) {
+    auto send=stock<Enqueue>(0x11a00ec0);
+    if (!sending.owner || type!=0x98 || n!=8 || p[0]!=sending.dest)
+        return send(queue,type,p,n,flags,src,dst);
+    alignas(4) u8 extended[20];
+    __builtin_memcpy(extended,p,8);
+    const u32 size=hprobe::encode(extended,sending,sending.fade ? sdk_voice_ticks() : 0);
+    ++sent[sending.dest];
+    return send(queue,type,extended,size,flags,src,dst);
+}
+u32 sdk_hprobe_dispatch(void* context,const u8* message) {
+    if (report(message)) return 1;
+    if (message[2]==0x98 && message[3]>=8 && message[4]<8) sawNote[message[4]]=true;
+    const Tag previous=receiving;
+    receiving=hprobe::decode(message,message[2]==0x98 && message[3]==20 ? sdk_voice_ticks() : 0);
+    // A decay-phase attack also supplies the release if an earlier notice was lost.
+    if (receiving.owner && receiving.fade) watches.release(receiving);
+    if (receiving.owner) ++received[receiving.dest];
+    const u32 result=stock<u32(void*,const u8*)>(0x8d5b1260)(context,message);
+    receiving=previous;
+    return result;
+}
+void* sdk_hprobe_fresh(u8* dst,const u8* src,u32 n) {
+    // Stock initializes active state then mirrors it into pending.
+    if (n==13) watches.bind(dst-0x64,for_track(src[1]),true);
+    return stock<void*(void*,const void*,u32)>(0x040230c4)(dst,src,n);
+}
+void sdk_hprobe_pending(void* voice,u32 track) {
+    watches.bind(voice,for_track(track),false);
+}
+void* sdk_hprobe_promote(u8* dst,const u8* src,u32 n) {
+    if (n==13) watches.promote(dst-0x54);
+    return stock<void*(void*,const void*,u32)>(0x040230c4)(dst,src,n);
+}
+u32 sdk_hprobe_render(void* voice,i32* output) {
+    const u32 index=watches.find(voice);
+    const bool fading=index<watches.size && watches.entries[index].active.fade;
+    const hprobe::Block block=watches.begin(index,fading ? sdk_voice_ticks() : 0);
+    const Tag t=block.tag;
+    const u32 result=stock<u32(void*,i32*)>(0x8d51bbaa)(voice,output);
+    block.apply(output);
+    if (result && t.owner) watches.remove(watches.find(voice));
+    if (t.owner && block.first) {
+        lastOwner[t.dest]=((u32(t.source)+1)<<16)|(t.owner&0xffff);
+        ++rendered[t.dest];
+    }
+    return result;
+}
+void sdk_hprobe_poll(u32 track,u32 now) {
+    if (track>=8) return;
+    const u32 age=now-gui.requestedAt;
+    if (track!=gui.track || now-gui.acknowledgedAt>=4*pollInterval) gui.valid=false;
+    if (gui.token && track==gui.track && age<pollInterval) return;
+    // Retry an outstanding token so a slow reply can still match. Rotate after
+    // a long absence, a track change, or a successful exchange.
+    if (!gui.token || track!=gui.track || age>=4*pollInterval || gui.acknowledgedToken==gui.token) {
+        if (!++gui.token) ++gui.token;
+    }
+    gui.track=track;
+    gui.requestedAt=now;
+    alignas(4) u8 request[requestSize]={0x48,'K',1,static_cast<u8>(track),'S'};
+    write32(request+5,gui.token);
+    send_report(request,sizeof request);
+}
+u32 sdk_hprobe_last(u32 dest) {
+    return gui.valid && dest==gui.track ? gui.owner : 0;
+}
+u32 sdk_hprobe_status(u32 dest) {
+    if (dest>=8) return 0;
+    return sent[dest]%100 | (gui.valid && dest==gui.track ? (1u<<25)|gui.counts : 0);
+}
+}

--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/hocket_settings.hpp
@@ -0,0 +1,80 @@
+// Included after the machine's Grid definition by its native player adapter.
+#pragma once
+#include "player_controls.hpp"
+namespace hocket_settings {
+using namespace opxy;
+enum { tracks=8, width=16, bytes=tracks*width };
+struct Track {
+    hocket::Grid grid;
+    i32 routeWords[4];
+    u8 flags;  // The three main-page encoder toggles, one bit per knob.
+    static u32 count(u32 k) { return k&1 ? hocket::delayChoices : 9u; }
+    static i32 centre(u32 k,u32 index) {
+        const u32 step=k&1 ? 0x7fffffffu/hocket::delayChoices : 0x7fffffffu/9u;
+        return index*step+step/2;
+    }
+    i32 route(u32 k) const { return routeWords[k]?routeWords[k]:centre(k,k&1?3:0); }
+    void apply(player::Controls& c) const {
+        for (u32 k=0;k<4;++k) {
+            c.shift_value[k]=route(k);
+            c.clicks[k]=(flags>>k)&1u;
+        }
+    }
+    void encode(u8* out) const {
+        for (u32 k=0;k<4;++k) out[k]=player::choice(route(k),count(k));
+        out[4]=flags|(grid.shuffle?16:0);
+        out[5]=grid.tail;
+        out[6]=grid.transpose+24;
+        out[7]=grid.mask();
+        for (u32 k=0;k<8;++k) out[8+k]=grid.pitch(k)+48;
+    }
+    static bool valid(const u8* in) {
+        for (u32 k=0;k<4;++k) if (in[k]>=count(k)) return false;
+        if ((in[4]&~29u) || in[5]>=hocket::spray_choices || in[6]>48) return false;
+        for (u32 k=0;k<8;++k) if (in[8+k]>96) return false;
+        return true;
+    }
+    void decode(const u8* in) {
+        for (u32 k=0;k<4;++k) routeWords[k]=centre(k,in[k]);
+        flags=in[4]&13;
+        grid.shuffle=in[4]&16;
+        grid.tail=in[5]; grid.transpose=static_cast<i32>(in[6])-24;
+        grid.pattern().changedMask=in[7]^15;
+        for (u32 k=0;k<8;++k) grid.pattern().set_pitch(k,static_cast<i32>(in[8+k])-48);
+    }
+};
+
+// The OS deserializes into the inactive buffer. Prepare that bank before
+// publishing its address. Playback only reads the bank for the active buffer.
+struct Projects {
+    Track banks[2][tracks];
+    const void* volatile second;
+    u32 bank(const void* project) const { return project && project==second ? 1 : 0; }
+    Track& track(const void* project,u32 t) { return banks[bank(project)][t]; }
+    void load(const void* current,const void* incoming,const u8* in) {
+        const u32 dst=1-bank(current);
+        if (in) for (u32 t=0;t<tracks;++t)
+            if (!Track::valid(in+t*width)) { in=nullptr; break; }
+        for (u32 t=0;t<tracks;++t) {
+            banks[dst][t]=Track{};
+            if (in) banks[dst][t].decode(in+t*width);
+        }
+        second=dst?incoming:current;
+    }
+    void save(const void* current,u8* out) {
+        for (u32 t=0;t<tracks;++t) track(current,t).encode(out+t*width);
+    }
+    bool snapshot(const void* active,const void* serialized,u8* out) {
+        // Stock OS 1.2.1 copies the live project to this fixed buffer before
+        // its serializer runs. The buffer has no Hocket settings bank of its own.
+        const void* stock_copy=reinterpret_cast<const void*>(0x85b7e3d4u);
+        if (!active || (serialized!=active && serialized!=stock_copy)) return false;
+        save(active,out);
+        return true;
+    }
+    void clear() {
+        for (auto& bank:banks) for (auto& t:bank) t=Track{};
+        second=nullptr;
+    }
+};
+}

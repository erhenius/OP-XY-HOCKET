diff --git a/sdk/platform/opxy-1.2.1/hocket_probe_hooks.s b/sdk/platform/opxy-1.2.1/hocket_probe_hooks.s
new file mode 100644
index 0000000..79ef1ba
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/hocket_probe_hooks.s
@@ -0,0 +1,46 @@
+.include "sdk/platform/opxy-1.2.1/hook.inc"
+.section .text
+.align 2
+/* Stock emitter, immediately before its twelve-argument note-on. Pass P5,
+ * the exact tone's pitch-byte pointer, as a thirteenth argument. FP+8 is
+ * the original caller SP. All nine original stack arguments are replayed. */
+.global sdk_hprobe_emit_hook
+.type sdk_hprobe_emit_hook, STT_FUNC
+sdk_hprobe_emit_hook:
+    LINK 52;
+    R3 = [FP + 20];
+    [SP + 12] = R3;
+    R3 = [FP + 24];
+    [SP + 16] = R3;
+    R3 = [FP + 28];
+    [SP + 20] = R3;
+    R3 = [FP + 32];
+    [SP + 24] = R3;
+    R3 = [FP + 36];
+    [SP + 28] = R3;
+    R3 = [FP + 40];
+    [SP + 32] = R3;
+    R3 = [FP + 44];
+    [SP + 36] = R3;
+    R3 = [FP + 48];
+    [SP + 40] = R3;
+    R3 = [FP + 52];
+    [SP + 44] = R3;
+    [SP + 48] = P5;
+    CALL sdk_hprobe_emit;
+    UNLINK;
+    RTS;
+.size sdk_hprobe_emit_hook, .-sdk_hprobe_emit_hook
+
+/* This write commits the pending velocity on both stock reuse branches. */
+.global sdk_hprobe_pending_hook
+.type sdk_hprobe_pending_hook, STT_FUNC
+sdk_hprobe_pending_hook:
+    HOOK_SAVE
+    R0 = P5;
+    R1 = R5;
+    CALL sdk_hprobe_pending;
+    HOOK_RESTORE
+    B[P5 + 0x64] = R6;
+    RTS;
+.size sdk_hprobe_pending_hook, .-sdk_hprobe_pending_hook
diff --git a/sdk/platform/opxy-1.2.1/hocket_probe_voice.hpp b/sdk/platform/opxy-1.2.1/hocket_probe_voice.hpp
new file mode 100644
index 0000000..b3415d8
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/hocket_probe_voice.hpp
@@ -0,0 +1,111 @@
+#pragma once
+#include <opxy/q31.hpp>
+namespace hprobe {
+using namespace opxy;
+// Index zero passes the voice through. Other indices follow the Spray menu.
+const u32 frames[]={0,44100,88200,132300,220500,11025,22050};
+const u32 gainStep[]={0,2147483647u/44100,2147483647u/88200,2147483647u/132300,
+                      2147483647u/220500,2147483647u/11025,2147483647u/22050};
+struct Tag {
+    u32 owner;
+    u8 source,dest,fade;
+    u32 start; // Local board clock. Only elapsed ticks cross the wire.
+};
+inline u32 wire_age(u32 now,u32 start) {
+    const u32 age=now-start;
+    return age<65535 ? age : 65535;
+}
+inline Tag decode(const u8* m,u32 now=0) {
+    if (m[2]!=0x98 || (m[3]!=16 && m[3]!=20)) return {};
+    const u8* p=m+4;
+    if (p[0]>=8 || p[8]!='H' || p[9]!='K' || p[11]>=8) return {};
+    const u32 id=u32(p[12])|(u32(p[13])<<8)|(u32(p[14])<<16)|(u32(p[15])<<24);
+    if (m[3]==16 && p[10]==1) return {id,p[11],p[0],0,0};
+    if (m[3]!=20 || p[10]!=2 || !p[16] || p[16]>6 || p[17]) return {};
+    return {id,p[11],p[0],p[16],now-(p[18]|(u32(p[19])<<8))};
+}
+inline u32 encode(u8* p,Tag t,u32 now=0) {
+    p[8]='H'; p[9]='K'; p[10]=t.fade?2:1; p[11]=t.source;
+    for (u32 i=0;i<4;++i) p[12+i]=static_cast<u8>(t.owner>>(8*i));
+    if (!t.fade) return 16;
+    const u32 age=wire_age(now,t.start);
+    p[16]=t.fade; p[17]=0; p[18]=static_cast<u8>(age); p[19]=static_cast<u8>(age>>8);
+    return 20;
+}
+struct Block {
+    Tag tag;
+    u32 elapsed;
+    bool first;
+    void apply(i32* out) const {
+        if (!tag.fade) return;
+        const u32 total=frames[tag.fade],step=gainStep[tag.fade];
+        u32 left=elapsed<total ? total-elapsed : 0;
+        u32 gain=left*step;
+        for (u32 i=0;i<64;++i,out+=2) {
+            if (!left) { out[0]=0; out[1]=0; continue; }
+            if (left!=total) {
+                out[0]=q31::multiply(out[0],static_cast<i32>(gain));
+                out[1]=q31::multiply(out[1],static_cast<i32>(gain));
+            }
+            --left;
+            gain-=step;
+        }
+    }
+};
+struct Watches {
+    struct Entry { const void* voice; Tag active,pending; u32 nextFrame; bool mirror,seen; };
+    Entry entries[27];
+    u32 size;
+    u32 find(const void* voice) const {
+        u32 i=0;
+        while (i<size && entries[i].voice!=voice) ++i;
+        return i;
+    }
+    void remove(u32 i) { if (i<size) entries[i]=entries[--size]; }
+    void bind(const void* voice,Tag t,bool fresh) {
+        u32 i=find(voice);
+        if (i==size) {
+            if (!t.owner || size==27) return;
+            entries[size++]={voice,{},{},0,false,false};
+        }
+        Entry& e=entries[i];
+        if (fresh) { e.active=t; e.nextFrame=0; e.seen=false; }
+        e.pending=t; e.mirror=fresh;
+        if (!e.active.owner && !e.pending.owner) remove(i);
+    }
+    void promote(const void* voice) {
+        const u32 i=find(voice);
+        if (i==size) return;
+        Entry& e=entries[i];
+        if (!e.mirror) { e.nextFrame=0; e.seen=false; }
+        e.active=e.pending; e.pending={}; e.mirror=false;
+        if (!e.active.owner) remove(i);
+    }
+    static void release_tag(Tag& voice,Tag t) {
+        if (voice.owner==t.owner && voice.source==t.source && voice.dest==t.dest && !voice.fade) {
+            voice.fade=t.fade; voice.start=t.start;
+        }
+    }
+    void release(Tag t) {
+        for (u32 i=0;i<size;++i) {
+            release_tag(entries[i].active,t);
+            release_tag(entries[i].pending,t);
+        }
+    }
+    Block begin(u32 i,u32 now) {
+        if (i>=size) return {};
+        Entry& e=entries[i];
+        Block block={e.active,0,!e.seen};
+        e.seen=true;
+        if (e.active.fade) {
+            const u32 total=frames[e.active.fade],age=now-e.active.start;
+            // 44.1 kHz, 400 MHz timer divided by 2^17. Clamp before multiplying.
+            u32 sample=age>=15260 ? total : (age*59190u)>>12;
+            if (sample<e.nextFrame) sample=e.nextFrame;
+            block.elapsed=sample;
+            e.nextFrame=sample>=total ? total : sample+64;
+        }
+        return block;
+    }
+};
+}

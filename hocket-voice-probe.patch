+    patches = [dict(kind='hook', address=hex(site), file_offset=hex(offset), length=len(before)//2,
+                    before=before, symbol=symbol, call=True, service='hocket_probe')
+               for site, offset, before, symbol in SITES]
+    # Reuse the SDK's two project-clear sites whether control, Hocket or both are selected.
+    clears = {'sdk_project_clear': 'sdk_hocket_new', 'sdk_project_clear_random': 'sdk_hocket_random'}
+    existing = [dict(item, service='hocket_project_clear', symbol=clears[item['symbol']])
+                if item.get('symbol') in clears else item for item in profile['patches']]
+    services = dict(profile['services'], hocket_probe=['hocket_probe'],
+                    hocket_project_clear=[*profile['services']['control'], 'hocket_probe'])
+    expanded = dict(profile, services=services, patches=existing + patches)
+    check_patch_boundaries(expanded, len(expanded['patches']))
+    return expanded
+
+def units():
+    """The two platform units are needed exactly when Hocket is in this link."""
+    return [('sdk/' + step + '.o', None, step)
+            for step in ('hocket_probe', 'hocket_probe_hooks')]
+
+
+def with_service(standard_users):
+    """Keep the SDK and extension service choices, then add Hocket's own."""
+    @wraps(standard_users)
+    def users(machines):
+        selected = standard_users(machines)
+        if any(m.kind == 'player' and m.id == 'hocket' for m in machines):
+            return selected + ['hocket_probe']
+        return selected
+    return users

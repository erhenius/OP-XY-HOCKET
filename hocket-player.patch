+// The stock scheduler compacts empty chord records. A clocked player may
+// republish one empty record after compaction while it has scheduled work.
+// Zero tones produce no MIDI, voice, or release, and player_store can reuse
+// slot zero immediately. Never replace or evict a sounding or queued chord.
+inline void player_clock_record(PlayerChord* records, volatile u32& held, bool pending) {
+    if (pending && held==0) {
+        records[0].count=0;
+        records[0].root=0;
+        held=1;
+    } else if (!pending && held==1 && !records[0].count) {
+        held=0;
+    }
+}

+struct HandoffPort {
+    void* object;
+    // Track index is the same stock field read by player_controls().
+    u32 track() const { return static_cast<const u32*>(object)[1]; }
+    opxy::player::Controls controls() const { return opxy::platform::player_controls(object); }
+    HandoffPort at(u32 dest) const {
+        return {dest==track() ? object : opxy::platform::player_object(dest,@PREFIX@_player_vtable)};
+    }
+    bool valid() const { return object!=nullptr; }
+    u32 time_stamp() const { return sdk_voice_ticks(); }
+    hocket::Grid& grid() const { return grids[track()]; }
+    State& memory() const { return state(object); }
+    void on(u32 pitch, opxy::u8 velocity) {
+        opxy::player::Plan plan;
+        plan.count = 1;
+        plan.tones[0] = {static_cast<opxy::u8>(pitch), velocity, 0};
+        opxy::platform::play_plan(object, pitch, plan);
+    }
+    void off(u32 pitch) {
+        opxy::platform::stock<void(void*, u32)>(opxy::platform::kMaestroRelease)(object, pitch);
+        maintain_clock(object);
+    }
+};
+#endif
 // +0x14: note-on (object, note, 0, flag, velocity) from the sequencer, live
 // or played back. Returning 1 takes the note; 0 lets the instrument play it.
 static u32 press(void* object, u32 note, u32, u32, u32 velocity) {
+#ifdef OPXY_HOCKET_PLAYER
+    if (note > 127 || !velocity || velocity > 127) {
+        state(object).probe = note > 127 ? @NAMESPACE@::Probe::noPitch : @NAMESPACE@::Probe::noVelocity;
+        return 0;
+    }
+    HandoffPort port = {object};
+    if (port.track()>=8) return 0;
+    @NAMESPACE@::press_key(state(object), port, note, velocity);
+    maintain_clock(object);
+#else
     opxy::player::Plan plan;
     if (!@NAMESPACE@::press(state(object), opxy::platform::player_controls(object), note, velocity, plan)) return 0;
     opxy::platform::play_plan(object, note, plan);
     apply_updates(object);
+#endif
     return 1;
 }
 // +0x18: note-off (object, note). Stock Maestro releases the chord whose root it is.
 static void release(void* object, u32 note) {
+#ifdef OPXY_HOCKET_PLAYER
+    HandoffPort port={object};
+    @NAMESPACE@::release_key(state(object),port,note);
+    maintain_clock(object);
+#else
     if (!@NAMESPACE@::release(state(object), note))
         opxy::platform::stock<void(void*, u32)>(opxy::platform::kMaestroRelease)(object, note);
     apply_updates(object);
+#endif
 }
 static void reset_player(void* object) {
+#ifdef OPXY_HOCKET_PLAYER
+    HandoffPort port={object};
+    @NAMESPACE@::expire(state(object),port,true);
+    opxy::platform::player_clock_pending(object,false);
+#endif
     opxy::platform::stock<void(void*)>(opxy::platform::kMaestroReset)(object);
     clear_state(state(object), 0);
 }
 static void all_off(void* object) {
+#ifdef OPXY_HOCKET_PLAYER
+    HandoffPort port={object};
+    @NAMESPACE@::expire(state(object),port,true);
+    opxy::platform::player_clock_pending(object,false);
+#endif
     opxy::platform::stock<void(void*)>(opxy::platform::kMaestroAllOff)(object);
     clear_state(state(object), 0);
 }
 // Run control-driven edits on the same role as note input and stock stepping,
 // before sounding the next tones. The GUI never edits chord records or State.
 static void step_player(void* object) {
+#ifdef OPXY_HOCKET_PLAYER
+    HandoffPort port = {object};
+    @NAMESPACE@::tick(state(object), port);
+#else
     apply_updates(object);
+#endif
     opxy::platform::stock<void(void*)>(opxy::platform::kMaestroStep)(object);
+#ifdef OPXY_HOCKET_PLAYER
+    // Stock has now consumed tones and compacted empty records.
+    maintain_clock(object);
+    using @NAMESPACE@::Probe;
+    State& s=state(object);
+    if ((s.probe==Probe::waiting || s.probe==Probe::stepped) && s.probeSteps<3) {
+        ++s.probeSteps;
+        // Stock marks a consumed tone with a negative delay. This records
+        // what its scheduler actually consumed, independent of the screen rate.
+        opxy::player::Display observed={};
+        opxy::platform::player_output(object,observed);
+        const u32 pitch=s.probePitch;
+        s.probe=(observed.played[pitch/32] & (1u<<(pitch%32))) ? Probe::consumed : Probe::stepped;
+    }
+#endif
 }
